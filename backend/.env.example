# Copy this file to `.env` and fill in your real values. Never commit `.env`.

# Your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Claude model (single model — no fallback)
MODEL=claude-sonnet-4-6

# Upload limit (megabytes)
MAX_FILE_SIZE_MB=10

# Comma-separated allowed frontend origins (CORS)
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
